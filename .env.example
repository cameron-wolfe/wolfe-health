# Copy to .env and fill in:  cp .env.example .env
# Every setting is listed in the README's "Configuration". On a server, edit
# .env in the install directory and restart the service.
#
# Oura OAuth2 application credentials (required)
# Register an application at https://developer.ouraring.com/applications
# with redirect URI http://localhost:8080/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Everything below is optional; the defaults are shown.

# Oura and storage
# WH_TOKEN_PATH=oura-token.json
# WH_DB_PATH=wolfe-health.db
# WH_DAYS=30               # days of history `make run` fetches
# WH_AUTH_PORT=8080        # the login callback's port

# The daemon. Each is also a flag, and a flag on the command line wins.
# WH_LISTEN=:8090
# WH_FETCH_EVERY=1h        # between scheduled fetches: 6h, 30m
# WH_FETCH_DAYS=7          # days each scheduled fetch refreshes
# WH_STARTUP_DAYS=365      # days the first fetch after a start covers
# WH_BACKUP_DIR=           # default: backups/ beside the database
# WH_BACKUP_KEEP=14        # daily snapshots to keep; 0 turns them off
# WH_LOG_REQUESTS=0        # 1 logs every HTTP request, the displays' routine reads included
# WH_WEBHOOK_LISTEN=       # Oura's webhook port, e.g. :8091
# WH_WEBHOOK_URL=          # the public HTTPS URL that reaches it

# Displays
# WH_TRMNL_BITS=2          # 2 for four grays, 1 for black and white
# WH_TRMNL_FORMAT=png      # or bmp (1-bit)
# WH_TRMNL_REFRESH=15m     # how long a TRMNL sleeps between updates
# WH_TEMP_ALERT_MIN=0.3    # °C above baseline for the screens' early-warning banner

# Phone alerts through Home Assistant: off unless the first three are set.
# See the README's "Phone alerts".
# WH_HA_URL=http://homeassistant.local:8123
# WH_HA_TOKEN=             # a long-lived access token: HA profile > Security
# WH_HA_NOTIFY=            # the phone's notify action, e.g. mobile_app_your_iphone
# WH_ALERT_LINK=           # this server as the phone reaches it, e.g. http://192.168.1.20:8090
# WH_ALERT_QUIET=22-7      # quiet hours, local: whole hours, 22:00-07:00, or off
# WH_ALERT_MAX_PER_DAY=10  # the most alerts a day (the test buttons don't count)
# WH_ALERT_SUMMARY_AT=8    # the morning summary's hour, or off
# WH_ALERTS_OFF=           # alerts to turn off: summary, illness, fetch, sync
# WH_ALERT_ILLNESS=2/2     # an early warning: signals up / nights running
# WH_ALERT_STALE=13h/18h   # no fetch working / no ring sync for this long
